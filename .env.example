# Local development uses `.data/store.json` and does not need these.

# Set to 1 on Vercel so each visitor gets an isolated 24h playground.
PLAYGROUND=1

# Required in production playground deploys (Upstash Redis).
# Local PLAYGROUND=1 without these uses in-memory maps (single Node process only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
